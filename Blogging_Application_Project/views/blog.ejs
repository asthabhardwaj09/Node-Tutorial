<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog Page</title>
</head>

<body>
    <%- include('./partials/nav') %>

        <div class="container mt-4">
            <div class="row row-cols-2">

            </div>

            <img src="<%= blog.coverImageURL %>" width="500px">
            <h1>
                <%= blog.title %>
            </h1>
            <pre class="mt-3"><%= blog.body %></pre>
        </div>

        <div class="container mt-4">
            <% if (blog.createdBy) { %>
                <img src="<%= blog.createdBy.profileImageUrl %>" width="50px" alt="Creator profile">
                <%= blog.createdBy.fullname %>
                    <% } else { %>
                        <p>Creator information not available.</p>
                        <% } %>
        </div>


        <div class="container mt-4">
            <h1>Comments</h1>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post">
                    <div class="mb-3">
                        <input type="text" class="form-control" name="content" placeholder="Enter your comment">
                        <button type="submit" class="btn btn-sm btn-primary">Add</button>
                </form>
        </div>
        <% } %>

            <div class="mt-3">
                <% comments.forEach(comment=> { %>
                    <div>
                        <img src="<%= comment.createdBy.profileImageUrl %>" width="50px" alt="Creator profile">
                        <%= comment.createdBy.fullname %>
                            <pre><%= comment.content %></pre>
                    </div>

                    <% }) %>
            </div>

            <%- include('./partials/script') %>
</body>

</html>